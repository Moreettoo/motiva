# Producao: estas mesmas variaveis vivem na Vercel, em Production E Preview.
# O procedimento de deploy e a lista completa estao em docs/operacao/deploy.md.
# O gatilho Git->Vercel esta mudo: um push NAO publica nada.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=chave service_role do Supabase

# Copiloto: o painel chama a OpenAI direto, sem passar pelo backend Python.
OPENAI_API_KEY=chave da OpenAI
# Opcional; sem isso vale gpt-5.4-mini, o mesmo padrao do backend.
OPENAI_MODEL=gpt-5.4-mini

# Reanalise sob demanda de um trecho: o painel dispara o workflow do GitHub
# Actions, que e onde o modelo .pkl roda. Token fine-grained com permissao
# Actions: Read and write, restrito a este repositorio.
GITHUB_TOKEN=github_pat_…
GITHUB_REPO=Moreettoo/motiva

# Sessao do usuario (Supabase Auth). A publishavel pode ir ao navegador; a secreta NUNCA.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta nova (sb_secret_...). Se vazia, o painel usa SUPABASE_SERVICE_KEY, que vale ate o fim de 2026.
SUPABASE_SECRET_KEY=

# Convite e redefinicao de senha saem pelo Resend. Sem dominio verificado o Resend so entrega
# para o e-mail da propria conta; a tela mostra o link copiavel de qualquer jeito.
RESEND_API_KEY=
EMAIL_REMETENTE="HighwAI <onboarding@resend.dev>"
# Base dos links de convite e redefinicao. Em producao,
# https://motiva-highwai.vercel.app — sem barra no fim.
# Sem esta variavel o default e o localhost abaixo, e ele NAO falha: entrega um
# link quebrado com cara de link bom no e-mail de quem foi convidado.
APP_URL=http://localhost:3000
CONVITE_VALIDADE_DIAS=7

# Senha unica das contas de demonstracao (scripts/semear-demonstracao.mjs).
# Obrigatoria, minimo 10 caracteres, SEM valor de reserva no codigo: o literal que
# ficava la era a senha de super.demo@, que nasce super_admin no mesmo banco de
# producao. Fica so aqui, e este arquivo e gitignored.
SEED_SENHA=
